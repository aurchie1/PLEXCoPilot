{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.29/MicrosoftTeams.schema.json",
  "manifestVersion": "1.29",
  "version": "1.0.0",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "My App, Inc.",
    "websiteUrl": "https://www.example.com",
    "privacyUrl": "https://www.example.com/privacy",
    "termsOfUseUrl": "https://www.example.com/termofuse"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
    "name": {
    "short": "PLEX Claims${{APP_NAME_SUFFIX}}",
    "full": "PLEX Claims Assistant"
  },
  "description": {
    "short": "Get your next GAP or AUTH claim and manage its status.",
    "full": "PLEX Claims Assistant picks your next GAP or AUTH claim by bucket priority, shows claim status and bucket from the PLEX SharePoint lists, and applies status transitions such as return to RVSR, authorize, concur and exclude."
  },
  "accentColor": "#FFFFFF",
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [],
  "copilotAgents": {
    "declarativeAgents": [
      {
        "id": "declarativeAgent",
        "file": "declarativeAgent.json"
      }
    ]
  }
}
